From 5fdd61316f852fbeac0315a826d198afd57388cd Mon Sep 17 00:00:00 2001
From: Max Krummenacher <max.krummenacher@toradex.com>
Date: Sat, 2 Mar 2024 17:06:10 +0100
Subject: [PATCH 3/3] jh7110-visionfive-v2.dtsi: disable not used video outputs

Upstream-Status: Pending
Signed-off-by: Max Krummenacher <max.krummenacher@toradex.com>
---
 arch/riscv/boot/dts/starfive/jh7110-evb.dtsi                | 6 ++++++
 .../boot/dts/starfive/jh7110-starfive-visionfive-2.dtsi     | 5 ++++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/starfive/jh7110-evb.dtsi b/arch/riscv/boot/dts/starfive/jh7110-evb.dtsi
index 24e28b0d30b6..3053336db629 100644
--- a/arch/riscv/boot/dts/starfive/jh7110-evb.dtsi
+++ b/arch/riscv/boot/dts/starfive/jh7110-evb.dtsi
@@ -143,10 +143,12 @@ dc_out_dpi1: endpoint@1 {
 			reg = <1>;
 			remote-endpoint = <&hdmi_in_lcdc>;
 		};
+#if 0
 		dc_out_dpi2: endpoint@2 {
 			reg = <2>;
 			remote-endpoint = <&mipi_in>;
 		};
+#endif
 	};
 };
 
@@ -155,6 +157,7 @@ &display {
 	status = "okay";
 };
 
+#if 0
 &dsi_output {
 	status = "okay";
 
@@ -177,6 +180,7 @@ mipi_out: endpoint {
 		};
 	};
 };
+#endif
 
 &gmac0 {
 	phy-handle = <&phy0>;
@@ -511,6 +515,7 @@ &mailbox_client0 {
 	status = "okay";
 };
 
+#if 0
 &mipi_dphy {
 	status = "okay";
 };
@@ -534,6 +539,7 @@ mipi_panel: panel@0 {
 		status = "okay";
 	};
 };
+#endif
 
 &pcie0 {
 	enable-gpios = <&sysgpio 32 GPIO_ACTIVE_HIGH>;
diff --git a/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2.dtsi b/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2.dtsi
index ed5771bae8a2..1af693a24f7b 100644
--- a/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2.dtsi
+++ b/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2.dtsi
@@ -440,11 +440,12 @@ dc_out_dpi1: endpoint@1 {
 			reg = <1>;
 			remote-endpoint = <&hdmi_in_lcdc>;
 		};
-
+#if 0
 		dc_out_dpi2: endpoint@2 {
 			reg = <2>;
 			remote-endpoint = <&mipi_in>;
 		};
+#endif
 	};
 };
 
@@ -484,6 +485,7 @@ hdmi_input0:endpoint@0 {
 	};
 };
 
+#if 0
 &dsi_output {
 	status = "okay";
 
@@ -544,6 +546,7 @@ dsi_in_port: endpoint {
 &mipi_dphy {
 	status = "okay";
 };
+#endif
 
 &co_process {
 	memory-region = <&e24_mem>;
