From 44029a7aab8e58c35f225d2ac56f0e9bf0aa6f0f Mon Sep 17 00:00:00 2001
From: Max Krummenacher <max.krummenacher@toradex.com>
Date: Sat, 2 Mar 2024 17:04:46 +0100
Subject: [PATCH 1/3] jh7110-visionfive-v2.dtsi: disable panels and
 touchscreens

Upstream-Status: Pending
Signed-off-by: Max Krummenacher <max.krummenacher@toradex.com>
---
 arch/riscv/boot/dts/starfive/jh7110-evb.dtsi          |  4 ++++
 .../dts/starfive/jh7110-starfive-visionfive-2.dtsi    | 11 ++++++++---
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/arch/riscv/boot/dts/starfive/jh7110-evb.dtsi b/arch/riscv/boot/dts/starfive/jh7110-evb.dtsi
index 7d26e86dd3a0..24e28b0d30b6 100644
--- a/arch/riscv/boot/dts/starfive/jh7110-evb.dtsi
+++ b/arch/riscv/boot/dts/starfive/jh7110-evb.dtsi
@@ -271,6 +271,7 @@ &i2c2 {
 	pinctrl-0 = <&i2c2_pins>;
 	status = "okay";
 
+#if 0
 	tinker_ft5406: tinker_ft5406@38 {
 		compatible = "tinker_ft5406";
 		reg = <0x38>;
@@ -302,6 +303,7 @@ panel_dsi_port: endpoint {
 			};
 		};
 	};
+#endif
 };
 
 &i2c3 {
@@ -517,9 +519,11 @@ &mipi_dsi {
 	status = "okay";
 
 	port {
+#if 0
 		dsi_out_port: endpoint@0 {
 			remote-endpoint = <&panel_dsi_port>;
 		};
+#endif
 		dsi_in_port: endpoint@1 {
 			remote-endpoint = <&mipi_out>;
 		};
diff --git a/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2.dtsi b/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2.dtsi
index b3a6a6f1deaa..a201dd8994cb 100644
--- a/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2.dtsi
+++ b/arch/riscv/boot/dts/starfive/jh7110-starfive-visionfive-2.dtsi
@@ -117,6 +117,7 @@ phy1: ethernet-phy@1 {
 };
 
 &i2c2 {
+#if 0
 	seeed_plane_i2c@45 {
 		compatible = "seeed_panel";
 		reg = <0x45>;
@@ -168,9 +169,11 @@ panel_out1: endpoint {
 			};
 		};
 	};
+#endif
 };
 
 &i2c6 {
+#if 0
 	imx219: imx219@10 {
 		compatible = "sony,imx219";
 		reg = <0x10>;
@@ -248,6 +251,7 @@ ov4689_to_csi2rx0: endpoint {
 			};
 		};
 	};
+#endif
 };
 
 &i2srx {
@@ -512,7 +516,7 @@ port@0 {
 			reg = <0>;
 			#address-cells = <1>;
 			#size-cells = <0>;
-
+#if 0 
 			dsi0_output: endpoint@0 {
 				reg = <0>;
 				remote-endpoint = <&panel_out0>;
@@ -522,7 +526,7 @@ dsi1_output: endpoint@1 {
 				reg = <1>;
 				remote-endpoint = <&panel_out1>;
 			};
-
+#endif
 		};
 
 		port@1{
@@ -581,7 +585,7 @@ port@1 {
 			reg = <1>;
 			#address-cells = <1>;
 			#size-cells = <0>;
-
+#if 0
 			/* CSI2 bus endpoint */
 			csi2rx0_from_imx219: endpoint@0 {
 				reg = <0>;
@@ -621,6 +625,7 @@ csi2rx0_from_imx296: endpoint@3 {
 				clock-noncontinuous;
 				status = "okay";
 			};
+#endif
 		};
 	};
 };
